{
  "name": "historical-nebula",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:shiji": "node scripts/import-shiji.mjs && node scripts/import-shiji-graph.mjs",
    "fetch:dynastic": "node scripts/fetch-dynastic-histories.mjs",
    "fetch:dynastic:short": "node scripts/fetch-dynastic-short-volumes.mjs",
    "import:dynastic": "node scripts/import-dynastic-histories.mjs",
    "verify:dynastic": "node scripts/verify-dynastic-histories.mjs",
    "fetch:modern": "node scripts/fetch-modern-documents.mjs",
    "import:modern": "node scripts/import-qingshigao.mjs && node scripts/import-modern-texts.mjs"
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "parse5": "^8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
