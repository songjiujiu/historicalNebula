{"volume":116,"blocks":[{"id":"p1","kind":"paragraph","html":"宗正，卿一人，中二千石。","text":"宗正，卿一人，中二千石。"},{"id":"p2","kind":"paragraph","html":"諸公主，每主家令一人，六百石。丞一人，三百石。","text":"諸公主，每主家令一人，六百石。丞一人，三百石。"},{"id":"p3","kind":"paragraph","html":"右屬宗正。","text":"右屬宗正。"},{"id":"p4","kind":"paragraph","html":"大司農","text":"大司農"},{"id":"p5","kind":"paragraph","html":"大司農，卿一人，中二千石。","text":"大司農，卿一人，中二千石。"},{"id":"p6","kind":"paragraph","html":"太倉令一人，六百石。","text":"太倉令一人，六百石。"},{"id":"p7","kind":"paragraph","html":"平準令一人，六百石。","text":"平準令一人，六百石。"},{"id":"p8","kind":"paragraph","html":"導官令一人，六百石。","text":"導官令一人，六百石。"},{"id":"p9","kind":"paragraph","html":"右屬大司農。","text":"右屬大司農。"},{"id":"p10","kind":"paragraph","html":"少府","text":"少府"},{"id":"p11","kind":"paragraph","html":"少府，卿一人，中二千石。","text":"少府，卿一人，中二千石。"},{"id":"p12","kind":"paragraph","html":"太醫令一人，六百石。","text":"太醫令一人，六百石。"},{"id":"p13","kind":"paragraph","html":"太官令一人，六百石。","text":"太官令一人，六百石。"},{"id":"p14","kind":"paragraph","html":"守宮令一人，六百石。","text":"守宮令一人，六百石。"},{"id":"p15","kind":"paragraph","html":"上林苑令一人，六百石。","text":"上林苑令一人，六百石。"},{"id":"p16","kind":"paragraph","html":"侍中，比二千石。","text":"侍中，比二千石。"},{"id":"p17","kind":"paragraph","html":"中常侍，千石。","text":"中常侍，千石。"},{"id":"p18","kind":"paragraph","html":"黃門侍郎，六百石。","text":"黃門侍郎，六百石。"},{"id":"p19","kind":"paragraph","html":"小黃門，六百石。","text":"小黃門，六百石。"},{"id":"p20","kind":"paragraph","html":"黃門令一人，六百石。","text":"黃門令一人，六百石。"},{"id":"p21","kind":"paragraph","html":"黃門署長、畫室署長、玉堂署長各一人。丙署長七人。皆四百石，黃綬。","text":"黃門署長、畫室署長、玉堂署長各一人。丙署長七人。皆四百石，黃綬。"},{"id":"p22","kind":"paragraph","html":"中黃門冗從僕射一人，六百石。","text":"中黃門冗從僕射一人，六百石。"},{"id":"p23","kind":"paragraph","html":"中黃門，比百石。","text":"中黃門，比百石。"},{"id":"p24","kind":"paragraph","html":"掖庭令一人，六百石。","text":"掖庭令一人，六百石。"},{"id":"p25","kind":"paragraph","html":"永巷令一人，六百石。","text":"永巷令一人，六百石。"},{"id":"p26","kind":"paragraph","html":"御府令一人，六百石。","text":"御府令一人，六百石。"},{"id":"p27","kind":"paragraph","html":"祠祀令一人，六百石。","text":"祠祀令一人，六百石。"},{"id":"p28","kind":"paragraph","html":"鈎盾令一人，六百石。","text":"鈎盾令一人，六百石。"},{"id":"p29","kind":"paragraph","html":"中藏府令一人，六百石。","text":"中藏府令一人，六百石。"},{"id":"p30","kind":"paragraph","html":"內者令一人，六百石。","text":"內者令一人，六百石。"},{"id":"p31","kind":"paragraph","html":"尚方令一人，六百石。","text":"尚方令一人，六百石。"},{"id":"p32","kind":"paragraph","html":"尚書令一人，千石。","text":"尚書令一人，千石。"},{"id":"p33","kind":"paragraph","html":"尚書僕射一人，六百石。","text":"尚書僕射一人，六百石。"},{"id":"p34","kind":"paragraph","html":"尚書六人，六百石。","text":"尚書六人，六百石。"},{"id":"p35","kind":"paragraph","html":"符節令一人，六百石。","text":"符節令一人，六百石。"},{"id":"p36","kind":"paragraph","html":"御史中丞一人，千石。","text":"御史中丞一人，千石。"},{"id":"p37","kind":"paragraph","html":"蘭台令史，六百石。","text":"蘭台令史，六百石。"},{"id":"p38","kind":"paragraph","html":"右屬少府。","text":"右屬少府。"}]}
