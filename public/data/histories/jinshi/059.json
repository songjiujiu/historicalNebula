raph","html":"洪靖","text":"洪靖"},{"id":"p151","kind":"paragraph","html":"洪熈","text":"洪熈"},{"id":"p152","kind":"paragraph","html":"洪衍","text":"洪衍"},{"id":"p153","kind":"paragraph","html":"洪輝","text":"洪輝"},{"id":"p154","kind":"paragraph","html":"葛王。","text":"葛王。"},{"id":"p155","kind":"paragraph","html":"右章宗子，凡六人。","text":"右章宗子，凡六人。"},{"id":"p156","kind":"paragraph","html":"從恪","text":"從恪"},{"id":"p157","kind":"paragraph","html":"琚","text":"琚"},{"id":"p158","kind":"paragraph","html":"瑄","text":"瑄"},{"id":"p159","kind":"paragraph","html":"璪","text":"璪"},{"id":"p160","kind":"paragraph","html":"右紹王子，史稱六子，可以名見者四人。","text":"右紹王子，史稱六子，可以名見者四人。"},{"id":"p161","kind":"paragraph","html":"守忠，鏗","text":"守忠，鏗"},{"id":"p162","kind":"paragraph","html":"玄齡","text":"玄齡"},{"id":"p163","kind":"paragraph","html":"守純，訛可","text":"守純，訛可"},{"id":"p164","kind":"paragraph","html":"孛德","text":"孛德"},{"id":"p165","kind":"paragraph","html":"右宣宗子，與末帝凡四人。他書載守純子三人，可以名見者二人。","text":"右宣宗子，與末帝凡四人。他書載守純子三人，可以名見者二人。"},{"id":"p166","kind":"paragraph","html":"阿古迺，不知世次，撻不也，胡十門，鉤室","text":"阿古迺，不知世次，撻不也，胡十門，鉤室"},{"id":"p167","kind":"paragraph","html":"不知世次，合住，蒲速越","text":"不知世次，合住，蒲速越"},{"id":"p168","kind":"paragraph","html":"余里也","text":"余里也"},{"id":"p169","kind":"paragraph","html":"布輝","text":"布輝"},{"id":"p170","kind":"paragraph","html":"保活里，四世孫滓不乃，石土門，習失","text":"保活里，四世孫滓不乃，石土門，習失"},{"id":"p171","kind":"paragraph","html":"思敬","text":"思敬"},{"id":"p172","kind":"paragraph","html":"阿斯懣。","text":"阿斯懣。"},{"id":"p173","kind":"paragraph","html":"迪古乃","text":"迪古乃"},{"id":"p174","kind":"paragraph","html":"婆盧火，婆速。，吾扎忽。","text":"婆盧火，婆速。，吾扎忽。"},{"id":"p175","kind":"paragraph","html":"胡特孛山，杲，宗安","text":"胡特孛山，杲，宗安"},{"id":"p176","kind":"paragraph","html":"什古，阿魯帶，襄","text":"什古，阿魯帶，襄"},{"id":"p177","kind":"paragraph","html":"崇成","text":"崇成"},{"id":"p178","kind":"paragraph","html":"冶訶，阿魯補","text":"冶訶，阿魯補"},{"id":"p179","kind":"paragraph","html":"骨𧹞，喜哥","text":"骨𧹞，喜哥"},{"id":"p180","kind":"paragraph","html":"訛古乃","text":"訛古乃"},{